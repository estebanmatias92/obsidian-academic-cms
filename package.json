{
  "name": "obsidian-academic-cms",
  "version": "0.2.0",
  "private": false,
  "description": "Obsidian Academic CMS — Templater Strangler → Plugin (pure domain, VaultPort, Obsidian API only)",
  "type": "commonjs",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.0"
  }
}
